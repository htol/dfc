# backup-to-server configuration, rendered by chezmoi.
# Parsed by ~/.local/bin/backup-to-server: the 'repo=' line plus restic
# exclude patterns below the 'excludes:' marker. The server name comes from
# chezmoi data (backup_server, sourced from ~/.config/personal/config.toml,
# local-only). Home-anchored paths use .chezmoi.homeDir.
{{ if .backup_server -}}
repo=sftp:{{ .backup_server }}:{{ .chezmoi.homeDir }}/!backups/restic/moon
{{- else -}}
# no repo= line rendered: set backup_server in ~/.config/personal/config.toml
{{- end }}

# restic exclude patterns: every non-comment line below this marker.
excludes:
# regenerable dependency/build dirs, anywhere in the tree
node_modules
.venv
venv
target
dist
__pycache__
