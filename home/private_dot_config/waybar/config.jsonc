// -*- mode: jsonc -*-
{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 25,
  "spacing": 2,
  "modules-left": [
    "custom/arch",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "wireplumber",
    "temperature",
    "battery",
    "hyprland/language",
    "clock"
  ],
  "include": [
    "~/.config/waybar/modules.json"
  ]
}
