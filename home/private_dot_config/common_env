export COMMON_ENV_LOADED=1
# This file is sourced by multiple shells. Keep it portable: exports only,
# no shell-specific conditionals, evals, hooks, or functions.
export EDITOR=nvim
export TERMINFO=$HOME/.config/terminfo

### Config for using vagrant with virtual box from WSL
export GEM_HOME="$HOME/.local/gem" # TODO: work very strange. need further investigation
export VAGRANT_HOME="$HOME/.local/vagrant.d"
export VAGRANT_WSL_ENABLE_WINDOWS_ACCESS="1"
# export PATH="$PATH:/mnt/c/Program Files/Oracle/VirtualBox"

export DOCKER_CONFIG="$HOME/.config/docker"

export ZDOTDIR="$HOME/.config/zsh"
export XDG_CONFIG_HOME="$HOME/.config"
export HISTFILE="$ZDOTDIR/.zsh_history"

export IPYTHONDIR="$HOME/.local/ipython"

export NPM_CONFIG_USERCONFIG="$HOME/.config/npm/npmrc"
export KEYCHAIN_DIR="$HOME/.cache/keychain"

export GOPATH="$HOME/go"
export GO111MODULE=on

export MISE_HOME="$HOME/.local/share/mise"
export SDKMAN_DIR="$HOME/.local/sdkman"
export BUN_INSTALL="$HOME/.local/bun"

# Coding agents: none of them follow XDG on their own, but each has its own knob.
export PI_CODING_AGENT_DIR="$HOME/.config/pi/agent"
export CODEX_HOME="$HOME/.config/codex"
export CLAUDE_CONFIG_DIR="$HOME/.config/claude"


export RUSTUP_HOME="$HOME/.local/rustup"
export CARGO_HOME="$HOME/.local/cargo"

export PATH="$HOME/.local/node/bin:$CARGO_HOME/bin:$HOME/.local/bin:$GOPATH/bin:$BUN_INSTALL/bin:$PATH"

# Reset system-wide uv config to defaults
unset UV_PYTHON_BIN_DIR UV_PYTHON_INSTALL_DIR
