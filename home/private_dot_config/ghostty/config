# infocmp -x xterm-ghostty | ssh YOUR-SERVER -- tic -x -
# terminal fallback in .ssh/config 
# Host *
#  SetEnv TERM=xterm-256color
#

config-file = ?optional-config-file
font-family = ""
font-family = "Menlo"
font-family = ""
font-family = "JetBrainsMono Nerd Font"
font-family = ""
font-family = "Meslo LG L"
font-family = ""
#font-family = "Iosevka"
font-size = 20

maximize = true

shell-integration-features = sudo
macos-option-as-alt = true

#background-opacity = 0.3

theme = Nord

# paste from CLIPBOARD (not PRIMARY) on Shift+Insert
keybind = shift+insert=paste_from_clipboard
# paste PRIMARY on Alt+Insert
keybind = alt+insert=paste_from_selection

# layout-independent bindings (physical / W3C key codes)
keybind = ctrl+key_d=text:\x04
keybind = ctrl+shift+key_c=copy_to_clipboard:mixed
keybind = ctrl+shift+key_v=paste_from_clipboard
keybind = ctrl+shift+key_t=new_tab
keybind = ctrl+shift+key_w=close_tab:this
keybind = ctrl+shift+key_n=new_window
keybind = ctrl+shift+key_q=quit
keybind = ctrl+shift+key_o=new_split:right
keybind = ctrl+shift+key_e=new_split:down
keybind = ctrl+shift+key_f=start_search
keybind = super+shift+key_f=text:exec fish
keybind = ctrl+shift+key_a=select_all
keybind = ctrl+shift+key_p=toggle_command_palette
keybind = ctrl+shift+key_i=inspector:toggle
keybind = ctrl+shift+key_j=write_screen_file:paste,plain
keybind = super+ctrl+shift+key_j=write_screen_file:copy,plain
keybind = ctrl+alt+shift+key_j=write_screen_file:open,plain
keybind = ctrl+shift+Comma=reload_config
keybind = ctrl+Comma=open_config
keybind = super+ctrl+bracket_left=goto_split:previous
keybind = super+ctrl+bracket_right=goto_split:next

scrollback-limit = 100000000
